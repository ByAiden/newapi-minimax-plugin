{
  "cases": [
    {
      "name": "video request sends the mapped model",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "requestBody": {
            "prompt": "A fox in snow",
            "seconds": 6,
            "duration": 6,
            "model": "MiniMax-H3"
          },
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": ""
          },
          "action": "text_to_video",
          "model": "video",
          "upstreamModel": "MiniMax-H3",
          "baseUrl": "https://api.minimaxi.com",
          "apiKey": "test-key",
          "authHeader": "test-key",
          "upstream": {
            "kind": "vendor"
          },
          "config": {},
          "files": [],
          "publicTaskId": "task_public"
        }
      ],
      "expected": {
        "url": "https://api.minimaxi.com/v2/video_generation",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer test-key"
        },
        "body": {
          "model": "MiniMax-H3",
          "content": [
            {
              "type": "text",
              "text": "A fox in snow"
            }
          ],
          "resolution": "768P",
          "duration": 6,
          "ratio": "16:9"
        },
        "action": "text_to_video"
      }
    },
